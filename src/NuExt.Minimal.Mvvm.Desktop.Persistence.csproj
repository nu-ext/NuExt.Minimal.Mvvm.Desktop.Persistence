<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;netstandard2.0;net11.0;net10.0;net9.0;net8.0;net471;net462</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Description>SQLite persistence layer for desktop MVVM applications, combining NuExt.Minimal.Mvvm.Desktop with NuExt.System.Data.SQLite: key/value settings DAL, application version storage, the application settings migration, and a database initializer.</Description>
    <RootNamespace>Minimal.Mvvm.Persistence</RootNamespace>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NETSDK1233</NoWarn>
    <VersionPrefix>0.9.9</VersionPrefix>
  </PropertyGroup>

  <ItemGroup Condition="'$(NuExt_UseLocalProjects)' != 'true'">
    <PackageReference Include="NuExt.Minimal.Mvvm.Desktop" Version="0.9.9" />
    <PackageReference Include="NuExt.System.Data.SQLite" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup Condition="'$(NuExt_UseLocalProjects)' == 'true'">
    <ProjectReference Include="..\..\NuExt.Minimal.Mvvm.Desktop\src\NuExt.Minimal.Mvvm.Desktop.csproj" />
    <ProjectReference Include="..\..\NuExt.System.Data.SQLite\src\NuExt.System.Data.SQLite.csproj" />
  </ItemGroup>

</Project>