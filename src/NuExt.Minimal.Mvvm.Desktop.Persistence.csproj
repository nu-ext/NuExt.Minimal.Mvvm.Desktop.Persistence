<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;netstandard2.0;net11.0;net10.0;net9.0;net8.0;net471;net462</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Minimal MVVM Desktop Persistence Library</Description>
    <RootNamespace>Minimal.Mvvm.Desktop.Persistence</RootNamespace>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;NETSDK1233</NoWarn>
    <VersionPrefix>0.9.5</VersionPrefix>
  </PropertyGroup>

  <ItemGroup Condition="'$(NuExt_UseLocalProjects)' != 'true'">
    <PackageReference Include="NuExt.Minimal.Mvvm.Desktop" Version="0.9.5" />
    <PackageReference Include="NuExt.System.Data.SQLite" Version="0.9.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(NuExt_UseLocalProjects)' == 'true'">
    <ProjectReference Include="..\..\NuExt.Minimal.Mvvm.Desktop\src\NuExt.Minimal.Mvvm.Desktop.csproj" />
    <ProjectReference Include="..\..\NuExt.System.Data.SQLite\src\NuExt.System.Data.SQLite.csproj" />
  </ItemGroup>

</Project>